# Optional: raises GitHub API rate limits and enables pinned-repo ordering
# for `npm run sync`. In GitHub Actions the built-in GITHUB_TOKEN is used.
GITHUB_TOKEN=

# Optional: serve /media/* (images, video, audio) from an external host
# (R2, S3, a CDN) that mirrors public/media. Leave empty to use GitHub Pages.
NEXT_PUBLIC_MEDIA_BASE_URL=
