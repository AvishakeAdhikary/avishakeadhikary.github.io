{
  "name": "avishakeadhikary.github.io",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "next build && node scripts/fix-export-segments.mjs && node scripts/fix-404-preloads.mjs",
    "start": "node scripts/serve-out.mjs",
    "sync": "node scripts/sync-github.mjs",
    "media:optimize": "node scripts/optimize-media.mjs",
    "lint": "eslint . --max-warnings=0",
    "lint:fix": "eslint . --fix",
    "typecheck": "tsc --noEmit",
    "check": "npm run lint && npm run typecheck && npm run test:unit && npm run build",
    "prepare": "husky",
    "icons": "node scripts/generate-icons.mjs",
    "verify": "npm run test:e2e",
    "test:unit": "vitest run",
    "test:e2e": "playwright test --project=chromium --project=firefox --project=webkit",
    "test:dev": "playwright test --project=dev",
    "test:live": "playwright test --project=live",
    "test": "npm run test:unit && npm run test:e2e"
  },
  "lint-staged": {
    "*.{js,mjs,jsx,ts,tsx}": [
      "eslint --fix --max-warnings=0"
    ]
  },
  "dependencies": {
    "@fontsource-variable/geist-mono": "^5.3.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@tailwindcss/postcss": "^4.3.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "cobe": "^2.0.1",
    "lucide-react": "^1.52.0",
    "next": "^16.3.8",
    "radix-ui": "^1.6.7",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "server-only": "^0.0.1",
    "simple-icons": "^16.34.0",
    "tailwind-merge": "^3.7.0",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.63.0",
    "@types/node": "^26.6.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.3.8",
    "ffmpeg-static": "^5.3.0",
    "happy-dom": "^20.14.5",
    "heic-decode": "^2.1.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "playwright": "^1.63.0",
    "postcss": "^8.5.28",
    "sharp": "^0.35.5",
    "svgo": "^4.1.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3",
    "vitest": "^5.0.3"
  },
  "allowScripts": {
    "ffmpeg-static": true,
    "unrs-resolver": true
  },
  "overrides": {
    "@next/eslint-plugin-next": {
      "fast-glob": "npm:tinyglobby@^0.2.17"
    }
  }
}
