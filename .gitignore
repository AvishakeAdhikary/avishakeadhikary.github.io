# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.js
.pnp.loader.mjs
.yarn/install-state.gz
.pnpm-store/

# testing / browser automation
/coverage
/.nyc_output
/test-results/
/playwright-report/
/blob-report/
/playwright/.cache/
.playwright-mcp/

# next.js
/.next/
/out/

# production
/build
/dist

# media pipeline cache (outputs in public/media ARE committed)
/.media-cache/

# misc
.DS_Store
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/
*.pem
*.log

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# env files (keep the documented example)
.env
.env*
!.env.example
*.local.*

# npm auth
.npmrc

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# editor / IDE
.idea/
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
*.swp
*.swo
*~

# AI agent local state (shared config like .mcp.json and CLAUDE.md is committed)
.claude/settings.local.json
.claude/worktrees/

# OS / temp
*.tmp
*.bak
*.orig

# lint / test caches
.eslintcache
.stylelintcache
.prettiercache

# turbo / next cache
.turbo/

# husky shim folder (auto-generated)
.husky/_/
